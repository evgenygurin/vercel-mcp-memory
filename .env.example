# Vercel Postgres (automatically provided by Vercel when you link a database)
# These will be auto-configured when you run: vercel env pull .env.local
POSTGRES_URL="postgresql://user:password@host:port/database?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:port/database?sslmode=require"

# Required: OpenAI API Key for embeddings
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional: API keys for authentication (comma-separated)
# Generate with: openssl rand -base64 32
# Leave empty or comment out for development without authentication
MCP_API_KEYS="your-generated-key-1,your-generated-key-2"
